{
  "name": "atb-fx-api",
  "version": "1.0.0",
  "private": true,
  "description": "A small FX API with exact decimal conversion and explicit rounding.",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/server.js",
    "ui": "node src/server.js --ui",
    "dev": "node --watch src/server.js --ui",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-exclude=src/server.js",
    "demo": "node scripts/demo.js"
  }
}
